# Host port the API is published on (pick a free one on shared servers).
APP_PORT=8090

# PocketBase admin (/_/) host port + bind address. Loopback-only by default;
# set PB_ADMIN_BIND=0.0.0.0 only where a reverse proxy serves it over HTTPS.
PB_ADMIN_PORT=8093
PB_ADMIN_BIND=127.0.0.1

# PocketBase superuser (created on first run; the api service logs in with it).
PB_ADMIN_EMAIL=admin@__APP_SLUG__.local
PB_ADMIN_PASSWORD=change-me-long

# [FEATURE: web-push] Web Push VAPID keys — generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The VAPID JWT `sub`: a routable https: URL or a mailto: on a REAL domain.
# Apple (iOS Web Push) validates this and rejects a non-routable domain
# (e.g. `.local`, `.invalid`, `.internal`) with 403 BadJwtToken — silently
# dropping every push. Chrome/FCM is lax, so this breaks ONLY iOS and only in
# production. Do NOT derive it from PB_ADMIN_EMAIL (that is `.local`). Use your
# real domain or contact email, e.g. https://app.example.com or mailto:you@example.com.
VAPID_SUBJECT=mailto:you@example.com
# Same value as VAPID_PUBLIC_KEY — exposed to the frontend build (public only).
VITE_VAPID_PUBLIC_KEY=

# Container timezone — crons and local-date math depend on it. Without it Node
# and Go silently run on UTC.
TZ=America/Toronto
