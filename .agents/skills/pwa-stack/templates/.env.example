# Used by deploy.sh as well as Compose: trusted Bash-compatible KEY=value
# assignments only. Single-quote literal values containing $, #, or spaces.
# Never commit .env / .env.dev or put private values in VITE_* variables.
# deploy.sh selects ENV_FILE, COMPOSE_PROJECT_NAME, PB_DATA_DIR and APP_ENV;
# do not set those in this file. Use a separate checkout for dev on a server.
# Branch override is explicit at invocation: DEPLOY_BRANCH=release ./deploy.sh

# Host port the API is published on (pick a free one on shared servers).
# In .env.dev, change BOTH APP_PORT and PB_ADMIN_PORT to unused host ports.
APP_PORT=8090

# Optional direct PocketBase diagnostic port; keep loopback-bound.
# Public admin URL: https://<app-domain>/_/ through the app API gateway.
PB_ADMIN_PORT=8093
PB_ADMIN_BIND=127.0.0.1

# PocketBase superuser (created on first run; the api service logs in with it).
PB_ADMIN_EMAIL=admin@__APP_SLUG__.local
PB_ADMIN_PASSWORD=

# Bounded health polling (seconds per request are bounded in deploy.sh too).
DEPLOY_HEALTH_ATTEMPTS=30
DEPLOY_HEALTH_INTERVAL=2

# [FEATURE: web-push] Web Push VAPID keys — generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Same value as VAPID_PUBLIC_KEY — exposed to the frontend build (public only).
VITE_VAPID_PUBLIC_KEY=

# Container timezone — crons and local-date math depend on it. Without it Node
# and Go silently run on UTC.
TZ=America/Toronto
